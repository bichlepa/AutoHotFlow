# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Custom for Visual Studio
*.cs     diff=csharp

# Standard to msysgit
*.doc	 diff=astextplain
*.DOC	 diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot  diff=astextplain
*.DOT  diff=astextplain
*.pdf  diff=astextplain
*.PDF	 diff=astextplain
*.rtf	 diff=astextplain
*.RTF	 diff=astextplain

# Test data is compared byte for byte (BOM, CRLF as written by AHF v1): no line-ending conversion
tests/data/flows/**/*.json -text
tests/data/variables/** -text

# The .ahf files are ZIP archives (binary): byte for byte, no line-ending conversion (WI-0081, the v1 export of the owner)
tests/data/ahf/** binary

# Language files are the v1 files, byte for byte (UTF-16 and CRLF as written by v1): no line-ending conversion
assets/language/** -text

# The language files and icons of the element packages are the v1 files, byte for byte (UTF-16 and CRLF as v1 wrote them)
src/elements/*/language/** -text
src/elements/*/Icons/** binary
