{
    // Tasks for tests and starts. Run with "Terminal: Run Task" (Ctrl+Shift+P).
    // Test tasks run pytest, which uses tools/ahkrun.py for the AHK tests itself.
    // Start tasks start AutoHotkey64.exe directly: they stay open until closed, so no timeout.
    // Note: a start task that hits a dialog (MsgBox, runtime error) waits for you to close it.
    "version": "2.0.0",
    "inputs": [
        {
            "id": "testGroups",
            "type": "promptString",
            "description": "Test groups, comma separated (doc/TEST-GROUPS.md), e.g. ui,docs",
            "default": "ui,docs"
        },
        {
            "id": "testFilter",
            "type": "promptString",
            "description": "pytest -k Ausdruck, z. B. engine or wait",
            "default": "engine"
        },
        {
            "id": "testPath",
            "type": "promptString",
            "description": "Testdatei oder Ordner, z. B. tests/fault/test_timeouts.py",
            "default": "tests/fault/test_timeouts.py"
        },
        {
            "id": "dataDir",
            "type": "promptString",
            "description": "Datenordner für --data (Test- statt echte Daten)",
            "default": "${env:TEMP}\\ahf_manual"
        },
        {
            "id": "suiteRef",
            "type": "promptString",
            "description": "Commit, Branch oder Tag fuer den Suite-Lauf im Worktree",
            "default": "HEAD"
        },
        {
            "id": "oracleSeed",
            "type": "promptString",
            "description": "Seed of the random run of the expression oracle (a failing seed is printed)",
            "default": "1"
        },
        {
            "id": "flowPath",
            "type": "promptString",
            "description": "Flow file or folder of flow files (v1 format)",
            "default": "tests/data/flows"
        },
        {
            "id": "oracleCount",
            "type": "promptString",
            "description": "Number of generated cases of the expression oracle",
            "default": "20000"
        },
        {
            "id": "workspaceName",
            "type": "promptString",
            "description": "Name des Workspaces (Branch wip/<Name>, Ordner neben dem Repo)",
            "default": "bugfix-1"
        },
        {
            "id": "historyMode",
            "type": "pickString",
            "description": "What to show from the test run history",
            "options": [
                "--last=20",
                "--flaky",
                "--load",
                "--durations"
            ],
            "default": "--last=20"
        },
        {
            "id": "recheckRun",
            "type": "promptString",
            "description": "Run id from the test run history (test_history.py --last), or latest",
            "default": "latest"
        }
    ],
    "tasks": [
        {
            "label": "Setup: install test dependencies",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pip",
                "install",
                "-r",
                "tests/requirements.txt"
            ],
            "problemMatcher": []
        },
        {
            "label": "Setup: git hooks (core.hooksPath)",
            "type": "process",
            "command": "git",
            "args": [
                "config",
                "core.hooksPath",
                "tools/hooks"
            ],
            "problemMatcher": []
        },
        {
            "label": "Test: fast (parallel, default, no slow, no foundation, no windows)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test: tests selected by my changes (--changed-from v2-port, parallel)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--changed-from",
                "v2-port"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: tests of named groups (--groups, e.g. ui,docs)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--groups",
                "${input:testGroups}"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: slow tests only (--all -m slow, parallel)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--all",
                "-m",
                "slow"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: everything except stress (--all, parallel; windows appear)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--all"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: gui (--all -m gui, windows and dialogs appear, do not use the PC)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--all",
                "-m",
                "gui",
                "-n",
                "0",
                "-v"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: hotkey input with key combinations (gui, keys are sent, do not use the PC)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests/integration/test_hotkey_input.py",
                "-q",
                "--all",
                "-m",
                "gui",
                "-n",
                "0",
                "-v"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: foundation (IPC, supervisor, diagnosis; incl. slow, no windows)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--foundation"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: everything except stress, serial, verbose (--all -n 0 -v)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "--all",
                "-n",
                "0",
