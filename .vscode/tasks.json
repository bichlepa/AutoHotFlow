{
    // Tasks for tests and starts. Run with "Terminal: Run Task" (Ctrl+Shift+P).
    // Test tasks run pytest, which uses tools/ahkrun.py for the AHK tests itself.
    // Start tasks start AutoHotkey64.exe directly: they stay open until closed, so no timeout.
    // Note: a start task that hits a dialog (MsgBox, runtime error) waits for you to close it.
    "version": "2.0.0",
    "inputs": [
        {
            "id": "testFilter",
            "type": "promptString",
            "description": "pytest -k Ausdruck, z. B. engine or wait",
            "default": "engine"
        },
        {
            "id": "testPath",
            "type": "promptString",
            "description": "Testdatei oder Ordner, z. B. tests/fault/test_timeouts.py",
            "default": "tests/fault/test_timeouts.py"
        },
        {
            "id": "dataDir",
            "type": "promptString",
            "description": "Datenordner für --data (Test- statt echte Daten)",
            "default": "${env:TEMP}\\ahf_manual"
        },
        {
            "id": "suiteRef",
            "type": "promptString",
            "description": "Commit, Branch oder Tag fuer den Suite-Lauf im Worktree",
            "default": "HEAD"
        },
        {
            "id": "workspaceName",
            "type": "promptString",
            "description": "Name des Workspaces (Branch wip/<Name>, Ordner neben dem Repo)",
            "default": "bugfix-1"
        }
    ],
    "tasks": [
        {
            "label": "Setup: install test dependencies",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pip",
                "install",
                "-r",
                "tests/requirements.txt"
            ],
            "problemMatcher": []
        },
        {
            "label": "Test: fast (parallel, default, no slow, no foundation, no windows)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test: slow tests only (--all -m slow, parallel)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--all",
                "-m",
                "slow"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: everything except stress (--all, parallel; windows appear)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--all"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: gui (--all -m gui, windows and dialogs appear, do not use the PC)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--all",
                "-m",
                "gui",
                "-n",
                "0",
                "-v"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: foundation (IPC, supervisor, diagnosis; incl. slow, no windows)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--foundation"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: everything except stress, serial, verbose (--all -n 0 -v)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "--all",
                "-n",
                "0",
                "-v"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: only last failures (--lf)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--lf"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: select by name (-k)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "-k",
                "${input:testFilter}"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: one file or folder, serial with output (debug)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "${input:testPath}",
                "-n",
                "0",
                "-v",
                "-s"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: AHK unit tests (tests/ahk)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests/test_ahk_runner.py",
                "-q"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: integration (tests/integration)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests/integration",
                "-q"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: end-to-end (tests/e2e)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests/e2e",
                "-q"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: fault injection incl. slow (--all -m fault)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-q",
                "--all",
                "-m",
                "fault"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: load JSON flows (legacy)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests/test_json_flows.py",
                "-q"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: architecture guard (pytest)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests/test_architecture.py",
                "-q"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: stress, serial, measurement (-m stress)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-m",
                "stress",
                "-v"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: soak, minutes, serial (-m soak)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests",
                "-m",
                "soak",
                "-v"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Tool: architecture guard (arch_check.py)",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/arch_check.py"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Tool: run suite at HEAD + uncommitted changes (worktree, you can keep working)",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/run_suite.py",
                "--with-changes"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Tool: run suite --all at HEAD + uncommitted changes (worktree)",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/run_suite.py",
                "--with-changes",
                "--",
                "tests",
                "-q",
                "--all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Tool: run suite at a commit (worktree)",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/run_suite.py",
                "--ref",
                "${input:suiteRef}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Tool: list the last suite runs (--status)",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/run_suite.py",
                "--status"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Tool: new workspace (worktree + branch wip/<name>)",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/new_workspace.py",
                "${input:workspaceName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Tool: list workspaces",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/new_workspace.py",
                "--list"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Tool: remove workspace (branch only when merged)",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/new_workspace.py",
                "--remove",
                "${input:workspaceName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Test data: copy skeleton flow to the data folder",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "New-Item -ItemType Directory -Force -Path '${input:dataDir}\\Flows' | Out-Null; Copy-Item -Force 'tests\\data\\skeleton_flow.json' '${input:dataDir}\\Flows\\skeleton.json'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Start: product (supervisor, no window)",
            "type": "process",
            "command": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "args": [
                "/ErrorStdOut=UTF-8",
                "src\\AutoHotFlow.ahk"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Start: product with debug window (--start=storage,engine,debug)",
            "type": "process",
            "command": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "args": [
                "/ErrorStdOut=UTF-8",
                "src\\AutoHotFlow.ahk",
                "--start=storage,engine,debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Start: debug window on running instance (--command=debug)",
            "type": "process",
            "command": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "args": [
                "/ErrorStdOut=UTF-8",
                "src\\AutoHotFlow.ahk",
                "--command=debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Start: manager stub with debug window (--ui=stub --start=storage,engine,manager,debug)",
            "type": "process",
            "command": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "args": [
                "/ErrorStdOut=UTF-8",
                "src\\AutoHotFlow.ahk",
                "--ui=stub",
                "--start=storage,engine,manager,debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Start: product, log level 3 (--start=storage,engine,debug)",
            "type": "process",
            "command": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "args": [
                "/ErrorStdOut=UTF-8",
                "src\\AutoHotFlow.ahk",
                "--log-level=3",
                "--start=storage,engine,debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Start: product, errors only in log (--log-level=0)",
            "type": "process",
            "command": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "args": [
                "/ErrorStdOut=UTF-8",
                "src\\AutoHotFlow.ahk",
                "--log-level=0"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Start: product headless (no window)",
            "type": "process",
            "command": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "args": [
                "/ErrorStdOut=UTF-8",
                "src\\AutoHotFlow.ahk",
                "--headless"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Start: test entry with test roles and debug window (echo:a, debug)",
            "type": "process",
            "command": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe",
            "args": [
                "/ErrorStdOut=UTF-8",
                "tests\\integration\\helpers\\AutoHotFlowTest.ahk",
                "--test-roles",
                "--start=echo:a,debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Debug: trigger Debug.Dump in test role echo:a (ahf_dump.py)",
            "type": "process",
            "command": "python",
            "args": [
                "tools/ahf_dump.py",
                "--title",
                "manuelle Prüfung"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
